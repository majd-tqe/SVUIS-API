{
  "name": "svuis-api",
  "version": "2.0.0",
  "description": "Unofficial REST API wrapper for SVUIS (Syrian Virtual University Information System). Scrape and extract student data from SVUIS portal via a clean REST interface.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "audit:portal": "tsx scripts/audit-portal.ts"
  },
  "keywords": [
    "svu",
    "svuis",
    "syrian-virtual-university",
    "university-api",
    "student-portal",
    "scraper",
    "rest-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/majd-tqe/SVUIS-API.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "swagger-jsdoc": { "glob": "^14.0.3" }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "iconv-lite": "^0.6.3",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0",
    "vite": "^8.3.5"
  }
}
